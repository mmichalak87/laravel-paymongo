{
    "name": "luigel/laravel-paymongo",
    "description": "A laravel wrapper for Paymongo API",
    "keywords": [
        "luigel",
        "laravel-paymongo"
    ],
    "homepage": "https://github.com/mmichalak87/laravel-paymongo",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rigel Kent Carbonel",
            "email": "rigel20.kent@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Luigel\\Paymongo\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Luigel\\Paymongo\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Luigel\\Paymongo\\LaravelPaymongoServiceProvider"
            ],
            "aliases": {
                "Paymongo": "Luigel\\Paymongo\\Facades\\Paymongo"
            }
        }
    }
}
